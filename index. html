<!DOCTYPE html>
<html lang="ky">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Азамат & Аида</title>

<style>

/* =====================================================
   НЕГИЗГИ
===================================================== */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #f5efe5;
    color: #594b3d;
    font-family: Georgia, "Times New Roman", serif;
}

button,
a {
    font-family: inherit;
}


/* =====================================================
   ENVELOPE SCREEN
===================================================== */

#envelopeScreen {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: hidden;

    background:
        radial-gradient(circle at 50% 40%,
        rgba(255,255,255,.95),
        rgba(244,235,219,.96) 55%,
        rgba(224,207,180,.98));

    transition:
        opacity 1.3s ease,
        visibility 1.3s ease;
}

#envelopeScreen.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}


/* жарык эффект */

#envelopeScreen::before {
    content: "";
    position: absolute;
    width: 700px;
    height: 700px;

    background: radial-gradient(
        circle,
        rgba(255,255,255,.9),
        transparent 65%
    );

    pointer-events: none;
}


/* =====================================================
   ENVELOPE
===================================================== */

.envelope {
    position: relative;

    width: 390px;
    height: 270px;

    perspective: 1200px;

    filter: drop-shadow(
        0 25px 30px rgba(70,50,30,.20)
    );
}


/* конверттин корпусу */

.envelope-body {
    position: absolute;
    inset: 0;

    overflow: visible;

    border-radius: 8px;

    background:
        linear-gradient(
            145deg,
            #fffdf8 0%,
            #eee3d1 48%,
            #fffaf0 100%
        );

    border: 2px solid #d3b98f;

    box-shadow:
        inset 0 0 0 5px rgba(255,255,255,.5),
        inset 0 0 20px rgba(120,90,50,.10);
}


/* алтын ички рамка */

.envelope-body::before {
    content: "";

    position: absolute;
    inset: 10px;

    border: 1px solid rgba(168,130,76,.45);

    border-radius: 4px;

    pointer-events: none;
}


/* бурчтагы кооздук */

.envelope-body::after {
    content: "❦";

    position: absolute;

    top: 8px;
    left: 16px;

    font-size: 28px;

    color: #b99a68;

    transform: rotate(-20deg);

    text-shadow:
        18px 4px 0 #cbb287,
        0 0 5px rgba(150,110,60,.2);

    pointer-events: none;
}


/* =====================================================
   FRONT FOLDS
===================================================== */

.envelope-body .fold-left {
    position: absolute;

    left: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    background:
        linear-gradient(
            145deg,
            rgba(210,192,164,.25),
            rgba(255,255,255,.5)
        );

    clip-path: polygon(
        0 0,
        50% 55%,
        100% 0,
        100% 100%,
        0 100%
    );

    pointer-events: none;
}


.envelope-body .fold-right {
    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            215deg,
            rgba(210,192,164,.18),
            rgba(255,255,255,.35)
        );

    clip-path: polygon(
        0 0,
        50% 55%,
        100% 0,
        100% 100%,
        0 100%
    );

    pointer-events: none;
}


/* =====================================================
   LETTER
===================================================== */

.letter {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 290px;
    height: 190px;

    transform:
        translate(-50%, -50%)
        translateY(10px)
        scale(.94);

    opacity: .55;

    z-index: 3;

    background:
        linear-gradient(
            135deg,
            #fffdf8,
            #f4ead9
        );

    border: 1px solid #d7c29d;

    box-shadow:
        0 10px 25px rgba(70,50,30,.15);

    transition:
        transform 2.2s cubic-bezier(.2,.7,.2,1),
        opacity 1.5s ease;

    pointer-events: none;
}


.letter::before {
    content: "А  &  А";

    position: absolute;

    left: 0;
    right: 0;
    top: 60px;

    text-align: center;

    font-size: 26px;

    color: #9a7a50;
    letter-spacing: 5px;
}


.envelope.open .letter {
    transform:
        translate(-50%, -50%)
        translateY(-145px)
        scale(1);

    opacity: 1;
}


/* =====================================================
   FLAP
===================================================== */

.flap {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 145px;

    z-index: 5;

    transform-origin: top center;

    background:
        linear-gradient(
            145deg,
            #fffdf8,
            #eadcc7 60%,
            #fffaf0
        );

    clip-path: polygon(
        0 0,
        100% 0,
        50% 100%
    );

    border-top: 2px solid #d3b98f;

    backface-visibility: hidden;

    transition:
        transform 2.5s cubic-bezier(.22,.61,.36,1);

    transform-style: preserve-3d;
}


/* flap ичиндеги сызык */

.flap::before {
    content: "";

    position: absolute;

    left: 8%;
    top: 5px;

    width: 84%;
    height: 110px;

    border-top: 1px solid rgba(160,125,75,.4);
    border-left: 1px solid rgba(160,125,75,.18);
    border-right: 1px solid rgba(160,125,75,.18);

    transform: perspective(300px) rotateX(0deg);

    pointer-events: none;
}


.envelope.open .flap {
    transform: rotateX(180deg);
}


/* =====================================================
   ОРНАМЕНТТЕР
===================================================== */

.ornament {
    position: absolute;

    z-index: 7;

    color: #ad8a58;

    font-size: 24px;

    text-shadow:
        0 1px 2px rgba(90,60,30,.15);
}

.ornament.top-left {
    top: 15px;
    left: 18px;
}

.ornament.top-right {
    top: 15px;
    right: 18px;
    transform: scaleX(-1);
}

.ornament.bottom-left {
    bottom: 13px;
    left: 18px;
    transform: rotate(180deg);
}

.ornament.bottom-right {
    bottom: 13px;
    right: 18px;
    transform: rotate(180deg) scaleX(-1);
}


/* =====================================================
   PEARLS
===================================================== */

.pearls {
    position: absolute;
    inset: 0;

    z-index: 6;

    pointer-events: none;
}

.pearl {
    position: absolute;

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle at 30% 25%,
            white,
            #d5c09b 65%,
            #a88c62
        );

    box-shadow:
        0 1px 3px rgba(80,60,30,.25);
}

.pearl.p1 { top: 18px; left: 48%; }
.pearl.p2 { top: 27px; left: 41%; }
.pearl.p3 { top: 27px; right: 41%; }
.pearl.p4 { top: 42px; left: 35%; }
.pearl.p5 { top: 42px; right: 35%; }
.pearl.p6 { bottom: 25px; left: 43%; }
.pearl.p7 { bottom: 25px; right: 43%; }


/* =====================================================
   OPEN BUTTON / SEAL
===================================================== */

.open-button {
    position: absolute;

    left: 50%;
    top: 55%;

    transform: translate(-50%, -50%);

    z-index: 20;

    width: 92px;
    height: 92px;

    border-radius: 50%;

    border: 4px double #b99560;

    background:
        radial-gradient(
            circle at 35% 30%,
            #fffefb,
            #e8d5b5 75%
        );

    color: #755b3b;

    box-shadow:
        0 5px 12px rgba(70,50,30,.25),
        inset 0 0 0 5px rgba(255,255,255,.5);

    cursor: pointer;

    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1.5px;

    transition:
        transform .5s ease,
        opacity .8s ease;
}


.open-button::before {
    content: "♡";

    position: absolute;

    left: 50%;
    top: 9px;

    transform: translateX(-50%);

    font-size: 17px;

    color: #9b7650;
}


.open-button span {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 17px;
}


.open-button:hover {
    transform:
        translate(-50%, -50%)
        scale(1.07);
}


.envelope.open .open-button {
    opacity: 0;
    transform:
        translate(-50%, -50%)
        scale(.5);
    pointer-events: none;
}


/* =====================================================
   INVITATION
===================================================== */

#invitation {
    opacity: 0;
    visibility: hidden;

    transition:
        opacity 1.3s ease,
        visibility 1.3s ease;
}

#invitation.show {
    opacity: 1;
    visibility: visible;
}


/* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 40px 20px;

    background:
        radial-gradient(
            circle at center,
            rgba(255,255,255,.75),
            transparent 65%
        );
}

.hero-inner {
    max-width: 700px;
}

.hero-small {
    font-size: 11px;
    letter-spacing: 5px;
    opacity: .65;
    margin-bottom: 25px;
}

.hero h1 {
    margin: 0;

    font-size: clamp(52px, 12vw, 100px);

    font-weight: 400;

    color: #705a42;
}

.hero-amp {
    margin: 5px 0;

    font-size: 42px;

    font-style: italic;

    color: #a0835b;
}

.hero-date {
    margin-top: 28px;

    font-size: 14px;

    letter-spacing: 5px;

    color: #806b52;
}


/* =====================================================
   GREETING
===================================================== */

.greeting {
    max-width: 720px;

    margin: auto;

    padding: 80px 25px;

    text-align: center;
}

.greeting h2 {
    font-size: 31px;

    font-weight: 400;

    margin-bottom: 25px;
}

.greeting p {
    font-size: 16px;

    line-height: 2;

    opacity: .8;
}


/* =====================================================
   COUNTDOWN
===================================================== */

.countdown-section {
    padding: 60px 20px;

    text-align: center;
}

.countdown-section h2 {
    font-weight: 400;
    font-size: 30px;
}

.countdown {
    max-width: 600px;

    margin: 30px auto;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 10px;
}

.time-box {
    padding: 20px 8px;

    background: rgba(255,255,255,.65);

    border: 1px solid rgba(130,100,60,.18);

    border-radius: 15px;
}

.time-box strong {
    display: block;

    font-size: 30px;

    font-weight: 400;
}

.time-box span {
    font-size: 10px;

    letter-spacing: 1px;

    opacity: .6;
}


/* =====================================================
   GALLERY
===================================================== */

.gallery-section {
    padding: 70px 20px;
}

.gallery-title {
    text-align: center;

    font-size: 30px;

    font-weight: 400;

    margin-bottom: 30px;
}

.gallery {
    max-width: 900px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 14px;
}

.gallery img {
    width: 100%;

    height: 300px;

    object-fit: cover;

    border-radius: 15px;

    cursor: pointer;

    transition: .4s;

    box-shadow:
        0 8px 20px rgba(60,40,20,.12);
}

.gallery img:hover {
    transform: scale(1.02);
}


/* =====================================================
   LIGHTBOX
===================================================== */

#lightbox {
    position: fixed;

    inset: 0;

    z-index: 10000;

    display: none;

    justify-content: center;
    align-items: center;

    background: rgba(20,15,10,.9);

    padding: 20px;
}

#lightbox.active {
    display: flex;
}

#lightboxImage {
    max-width: 90vw;
    max-height: 85vh;

    object-fit: contain;

    border-radius: 10px;
}

.lightbox-close,
.lightbox-prev,
.lightbox-next {
    position: absolute;

    border: none;

    background: rgba(255,255,255,.15);

    color: white;

    cursor: pointer;

    border-radius: 50%;

    width: 45px;
    height: 45px;

    font-size: 22px;
}

.lightbox-close {
    top: 20px;
    right: 20px;
}

.lightbox-prev {
    left: 20px;
}

.lightbox-next {
    right: 20px;
}


/* =====================================================
   LOCATION
===================================================== */

.location-section {
    padding: 70px 20px;

    text-align: center;
}

.section-title {
    text-align: center;

    margin-bottom: 30px;
}

.small-title {
    font-size: 11px;

    letter-spacing: 4px;

    opacity: .65;

    margin-bottom: 10px;
}

.section-title h2 {
    font-family: Georgia, serif;

    font-size: 34px;

    font-weight: 400;

    margin: 5px 0 12px;
}

.section-title p {
    font-size: 14px;

    opacity: .7;
}

.location-card {
    max-width: 430px;

    margin: auto;

    padding: 35px 25px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.9),
            rgba(245,238,226,.9)
        );

    border: 1px solid rgba(150,120,80,.25);

    border-radius: 25px;

    box-shadow:
        0 15px 40px rgba(70,50,30,.12);
}

.location-icon {
    font-size: 35px;

    margin-bottom: 10px;
}

.location-card h3 {
    font-family: Georgia, serif;

    font-size: 25px;

    font-weight: 400;

    margin: 10px 0;
}

.location-card p {
    line-height: 1.8;

    font-size: 15px;

    opacity: .75;

    margin-bottom: 25px;
}

.map-button {
    display: inline-block;

    padding: 14px 24px;

    border-radius: 30px;

    background: #80684d;

    color: white;

    text-decoration: none;

    font-size: 12px;

    letter-spacing: 1px;

    transition: .3s;
}

.map-button:hover {
    transform: translateY(-2px);

    box-shadow:
        0 8px 20px rgba(80,60,40,.2);
}


/* =====================================================
   RSVP
===================================================== */

.rsvp-section {
    padding: 70px 20px 80px;
}

.rsvp-form {
    max-width: 500px;

    margin: auto;
}

.rsvp-option {
    position: relative;

    display: flex;

    align-items: center;

    gap: 15px;

    padding: 18px 20px;

    margin-bottom: 12px;

    background: rgba(255,255,255,.75);

    border: 1px solid rgba(120,100,70,.2);

    border-radius: 18px;

    cursor: pointer;

    transition: .3s;
}

.rsvp-option:hover {
    transform: translateY(-2px);

    box-shadow:
        0 8px 20px rgba(70,50,30,.08);
}

.rsvp-option input {
    position: absolute;

    opacity: 0;
}

.custom-radio {
    width: 21px;
    height: 21px;

    min-width: 21px;

    border: 2px solid #8a7357;

    border-radius: 50%;

    position: relative;
}

.rsvp-option input:checked + .custom-radio {
    background: #8a7357;

    box-shadow:
        inset 0 0 0 5px #fff;
}

.rsvp-option b {
    display: block;

    font-size: 14px;

    font-weight: 500;
}

.rsvp-option small {
    display: block;

    margin-top: 4px;

    font-size: 11px;

    opacity: .6;
}

.rsvp-button {
    width: 100%;

    margin-top: 15px;

    padding: 16px;

    border: none;

    border-radius: 30px;

    background: #80684d;

    color: white;

    font-size: 12px;

    letter-spacing: 1.5px;

    cursor: pointer;

    transition: .3s;
}

.rsvp-button:disabled {
    opacity: .35;

    cursor: not-allowed;
}

.rsvp-button:not(:disabled):hover {
    transform: translateY(-2px);

    box-shadow:
        0 8px 20px rgba(80,60,40,.2);
}

.rsvp-message {
    text-align: center;

    margin-top: 18px;

    font-size: 13px;

    line-height: 1.6;
}


/* =====================================================
   FOOTER
===================================================== */

.wedding-footer {
    text-align: center;

    padding: 55px 20px 70px;

    background:
        rgba(120,100,70,.06);
}

.footer-names {
    font-family: Georgia, serif;

    font-size: 28px;
}

.footer-names span {
    margin: 0 8px;

    font-style: italic;
}

.footer-date {
    margin-top: 12px;

    letter-spacing: 4px;

    font-size: 12px;

    opacity: .65;
}

.wedding-footer p {
    max-width: 400px;

    margin: 20px auto 0;

    font-size: 12px;

    line-height: 1.7;

    opacity: .6;
}


/* =====================================================
   MUSIC
===================================================== */

#musicButton {
    position: fixed;

    right: 18px;
    bottom: 18px;

    z-index: 5000;

    width: 48px;
    height: 48px;

    border-radius: 50%;

    border: 1px solid rgba(120,90,50,.3);

    background: rgba(255,255,255,.85);

    cursor: pointer;

    font-size: 20px;

    box-shadow:
        0 5px 15px rgba(60,40,20,.15);
}

#voiceStatus {
    position: fixed;

    left: 50%;

    bottom: 20px;

    transform: translateX(-50%);

    z-index: 5001;

    padding: 10px 17px;

    border-radius: 20px;

    background: rgba(70,55,40,.85);

    color: white;

    font-size: 11px;

    display: none;
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

    .envelope {
        width: 315px;
        height: 220px;
    }

    .letter {
        width: 235px;
        height: 155px;
    }

    .envelope.open .letter {
        transform:
            translate(-50%, -50%)
            translateY(-115px)
            scale(1);
    }

    .flap {
        height: 120px;
    }

    .open-button {
        width: 82px;
        height: 82px;

        font-size: 9px;
    }

    .hero h1 {
        font-size: 58px;
    }

    .hero-amp {
        font-size: 32px;
    }

    .countdown {
        gap: 6px;
    }

    .time-box {
        padding: 15px 5px;
    }

    .time-box strong {
        font-size: 23px;
    }

    .gallery {
        grid-template-columns: 1fr;
    }

    .gallery img {
        height: 350px;
    }
}

</style>
</head>


<body>


<!-- =====================================================
     AUDIO
===================================================== -->

<audio id="weddingMusic" loop preload="auto">
    <source src="music.mp3" type="audio/mpeg">
</audio>

<audio id="weddingVoice" preload="auto">
    <source src="voice.mp3" type="audio/mpeg">
</audio>


<!-- =====================================================
     ENVELOPE
===================================================== -->

<div id="envelopeScreen">

    <div class="envelope" id="envelope">

        <div class="envelope-body">

            <div class="fold-left"></div>
            <div class="fold-right"></div>

            <div class="letter"></div>

            <div class="ornament top-left">❦</div>
            <div class="ornament top-right">❦</div>
            <div class="ornament bottom-left">❦</div>
            <div class="ornament bottom-right">❦</div>

            <div class="pearls">
                <i class="pearl p1"></i>
                <i class="pearl p2"></i>
                <i class="pearl p3"></i>
                <i class="pearl p4"></i>
                <i class="pearl p5"></i>
                <i class="pearl p6"></i>
                <i class="pearl p7"></i>
            </div>

        </div>


        <div class="flap"></div>


        <button
            class="open-button"
            id="openButton"
            onclick="openInvitation()"
        >
            <span>БАСЫҢЫЗ</span>
        </button>

    </div>

</div>


<!-- =====================================================
     INVITATION
===================================================== -->

<main id="invitation">


    <!-- HERO -->

    <section class="hero">

        <div class="hero-inner">

            <div class="hero-small">
                WEDDING INVITATION
            </div>

            <h1>Азамат</h1>

            <div class="hero-amp">&</div>

            <h1>Аида</h1>

            <div class="hero-date">
                20 • 09 • 2026
            </div>

        </div>

    </section>


    <!-- GREETING -->

    <section class="greeting">

        <h2>
            Урматтуу туугандар,<br>
            кадырлуу достор!
        </h2>

        <p>
            Сиздерди уулубуз Азамат менен
            келинибиз Аиданын
            үйлөнүү тоюна арналган
            салтанаттуу кечеге
            чын жүрөктөн чакырабыз.
        </p>

        <p>
            Бул өзгөчө күндө сиздер менен
