    <section class="gallery-section">

        <h2 class="gallery-title">
            Биздин көз ирмемдер
        </h2>

        <div class="gallery">

            <img
                src="photo1.jpg"
                onclick="openPhoto(0)"
                alt="Азамат & Аида"
            >

            <img
                src="photo2.jpg"
                onclick="openPhoto(1)"
                alt="Азамат & Аида"
            >

            <img
                src="photo3.jpg"
                onclick="openPhoto(2)"
                alt="Азамат & Аида"
            >

            <img
                src="photo4.jpg"
                onclick="openPhoto(3)"
                alt="Азамат & Аида"
            >

        </div>

    </section>


    <!-- LOCATION -->

    <section class="location-section">

        <div class="section-title">

            <div class="small-title">
                ТОЙ ӨТҮҮЧҮ ЖЕР
            </div>

